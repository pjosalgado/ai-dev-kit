# Test gate configuration - sourced by the hook scripts after HOOKS_DIR is set.
#
# KIT_RUNTIME: ai-dev-kit-side state (marker, recorded target, lock, hook log).
#   Target-independent, so the gate works for any project.
# TARGET_PROJECT: fallback target when no sentinel has recorded one (e.g. the
#   agentStop safety net firing before any sentinel run). Override by exporting
#   TARGET_PROJECT or editing the default below. Normally the sentinel's
#   `<project-dir>` argument wins via .last-target.
KIT_ROOT="$(cd "$HOOKS_DIR/../../.." && pwd)"
KIT_RUNTIME="$HOOKS_DIR/../.runtime"
LAST_TARGET_FILE="$KIT_RUNTIME/.last-target"
if [ -z "${TARGET_PROJECT:-}" ]; then
  TARGET_PROJECT="$KIT_ROOT/../poc-srv-collectors-titleregistration"
fi
if [ -d "$TARGET_PROJECT" ]; then
  TARGET_PROJECT="$(cd "$TARGET_PROJECT" && pwd)"
else
  TARGET_PROJECT=""
fi
